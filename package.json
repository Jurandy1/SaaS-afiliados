    "sync:gcp": "node gcp/sync-server.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.49.1",
    "pg": "^8.14.1",
    "satori": "^0.29.1",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=18"
  }
}
