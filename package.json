{
  "name": "shopylitcs-saas-afiliados",
  "version": "0.2.0",
  "private": true,
  "author": "Jurandy",
  "description": "Shopylitcs — SaaS afiliados (Shopee + Meta + Pinterest + Supabase)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:css": "npx --yes tailwindcss@3.4.17 -i ./styles/tailwind.css -o ./public/tailwind.css --minify",
    "build": "npm run build:css",
    "postinstall": "node scripts/install-git-hooks.cjs",
    "hooks:install": "node scripts/install-git-hooks.cjs",
    "contributors:refresh": "node scripts/refresh-github-contributors.cjs",
    "vercel-build": "npm run build:css",
    "setup:db": "node scripts/setup-db.cjs",
    "seed:demo": "node scripts/seed-demo.cjs",
    "sync:auto": "node scripts/run-auto-sync.cjs",
    "push:ontem": "node scripts/push-ontem.cjs",
    "sync:gcp": "node gcp/sync-server.js"
  },
  "dependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@supabase/supabase-js": "^2.49.1",
    "@vercel/og": "^1.0.1",
    "pg": "^8.14.1",
    "puppeteer": "^25.8.0",
    "satori": "^0.29.1",
    "stripe": "^17.7.0",
    "web-push": "^3.6.7"
  },
  "engines": {
    "node": ">=18"
  }
}
