{
  "name": "metricly-saas-afiliados",
  "version": "0.2.0",
  "private": true,
  "description": "SaaS afiliados — dashboard Shopee + Meta + Pinterest (Supabase)",
  "main": "server/index.js",
  "scripts": {
    "start": "node server/index.js",
    "dev": "node --watch server/index.js",
    "build:css": "npx --yes tailwindcss@3.4.17 -i ./styles/tailwind.css -o ./public/tailwind.css --minify",
    "build": "npm run build:css",
    "vercel-build": "npm run build:css",
    "setup:db": "node scripts/setup-db.cjs",
