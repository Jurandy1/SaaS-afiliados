PORT=3790

# Supabase (obrigatório no Railway / Vercel)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Admin da área /admin
ADMIN_EMAIL=teste@gmail.com

# URL pública (Checkout / Portal / banner push)
# No Railway: use o domínio *.up.railway.app após gerar o domínio público
PUBLIC_BASE_URL=https://SEU-APP.up.railway.app

# Stripe Billing
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_1U87aaLcve75re8rKD3UjDZa
STRIPE_PRICE_6M=price_1U87aaLcve75re8rXjAdHqri
STRIPE_PRICE_12M=price_1U87aZLcve75re8rgdyW6j06

# Cron automático — o Google (Apps Script / Cloud Scheduler) chama /api/cron/sync
CRON_SECRET=<gere um token longo; o Cloud Scheduler envia no header>

# Push Web (opcional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:admin@example.com

# Shopee/Meta NÃO vão como env global —
# cada usuário configura na própria conta após login (ou no cadastro).

# Claude / Anthropic — preferível na conta do usuário (Configurações → Conexões).
# CLAUDE_API_KEY= só como fallback local de desenvolvimento, se quiser.
# CLAUDE_MODEL=claude-sonnet-4-6

# Pinterest Ads API — opcional; preferível salvar na conta do usuário
PINTEREST_APP_ID=
PINTEREST_ACCESS_TOKEN=
PINTEREST_AD_ACCOUNT_IDS=

# Checklist Railway: veja railway.env.example + DEPLOY.md
