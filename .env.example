PORT=3790

# Supabase (obrigatório no Vercel)
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# Admin da área /admin
ADMIN_EMAIL=teste@gmail.com

# Cron automático — o Google (Apps Script / Cloud Scheduler) chama /api/cron/sync
# Não use cron da Vercel. Defina o mesmo secret no script do Google.
CRON_SECRET=<gere um token longo; o Cloud Scheduler envia no header>

# Shopee/Meta NÃO vão no Vercel como padrão —
# cada usuário configura na própria conta após login (ou no cadastro).

# Claude / Anthropic NÃO vai no Vercel como padrão —
# cada usuário cola a própria key em Configurações → Conexões (salva em app_settings).
# CLAUDE_API_KEY= só como fallback local de desenvolvimento, se quiser.
# CLAUDE_MODEL=claude-sonnet-4-6

# Pinterest Ads API — opcional; preferível salvar na conta do usuário
PINTEREST_APP_ID=
PINTEREST_ACCESS_TOKEN=
PINTEREST_AD_ACCOUNT_IDS=
