# =============================================================================
# Variáveis para o Railway (Settings → Variables)
# Cole cada chave/valor no painel. NÃO commite secrets reais.
# Railway define PORT automaticamente — não precisa criar PORT.
# =============================================================================

# --- Obrigatórias ---
SUPABASE_URL=https://SEU_PROJETO.supabase.co
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_DB_PASSWORD=

# URL pública do app no Railway (depois do 1º deploy, use o domínio gerado)
# Ex.: https://saas-afiliados-production-xxxx.up.railway.app
PUBLIC_BASE_URL=https://SEU-APP.up.railway.app

ADMIN_EMAIL=seu-email@gmail.com

# --- Stripe (billing) ---
STRIPE_SECRET_KEY=sk_live_...
STRIPE_WEBHOOK_SECRET=whsec_...
STRIPE_PRICE_MONTHLY=price_1U87aaLcve75re8rKD3UjDZa
STRIPE_PRICE_6M=price_1U87aaLcve75re8rXjAdHqri
STRIPE_PRICE_12M=price_1U87aZLcve75re8rgdyW6j06

# --- Cron / sync (Google Cloud Scheduler ou Apps Script) ---
CRON_SECRET=

# --- Push Web (opcional; se usar notificações) ---
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_MAILTO=mailto:seu-email@gmail.com

# --- Opcional / fallback local ---
# AUTO_SYNC_DISABLE=1
# CLAUDE_API_KEY=
# CLAUDE_MODEL=claude-sonnet-4-6
# PINTEREST_APP_ID=
# PINTEREST_ACCESS_TOKEN=
# PINTEREST_AD_ACCOUNT_IDS=
# DATABASE_URL=
